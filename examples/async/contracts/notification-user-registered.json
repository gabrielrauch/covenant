{
  "metadata": {
    "id": "178b96c0-0c0c-469b-bf79-857387371eb0",
    "version": "1.0.0",
    "consumer": {
      "name": "notification-service"
    },
    "provider": {
      "name": "user-service"
    },
    "status": "draft",
    "created_at": "2025-12-23T03:20:41.221389Z"
  },
  "interactions": [
    {
      "id": "user-registered",
      "description": "user registered event",
      "protocol": "async",
      "payload": {
        "async": {
          "destination": "users.registered",
          "direction": "publish",
          "message": {
            "headers": {
              "event-type": "UserRegistered"
            },
            "payload": {
              "email": "user@example.com",
              "name": "Test User",
              "user_id": "user-001"
            }
          }
        }
      },
      "matching_rules": {
        "$.message.payload.email": {
          "match": "regex",
          "pattern": "^[^@]+@[^@]+\\.[^@]+$"
        },
        "$.message.payload.user_id": {
          "match": "type"
        }
      }
    }
  ]
}
